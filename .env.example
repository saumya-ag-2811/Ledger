# Server Configuration
PORT=5000
NODE_ENV=development

# Google OAuth 2.0 Credentials
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Security & Session Secrets
# Generate random 32+ character strings for production
SESSION_SECRET=change-this-to-a-secure-random-string-in-production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend URL (for OAuth redirect and CORS)
FRONTEND_URL=http://localhost:3000
